# OpenAI Whisper transcription
#
# These are read ONLY by the Netlify function (netlify/functions/transcribe.ts),
# which runs on the server and hides your key from the browser. The browser
# never sees these values.
#
# Setup: copy this file to `.env` and paste your real key.
#   cp .env.example .env
# `.env` is gitignored — never commit real keys.

# Your OpenAI API key (starts with sk-...). Required.
OPENAI_API_KEY=

# Optional: override the transcription endpoint. Defaults to OpenAI Whisper.
# Point this at a Lightning-hosted Whisper later to swap providers.
# TRANSCRIBE_ENDPOINT=https://api.openai.com/v1/audio/transcriptions

# Phase-4 agent proxy (netlify/functions/agent.ts)
#
# Read ONLY by the agent function, which runs on the server and forwards the
# conversation to the Claude Messages API. The browser never sees this key.
#
# Your Anthropic API key (starts with sk-ant-...). Required for the agent.
ANTHROPIC_API_KEY=
